  "title": "Thừa thiếu, Tác hại & Vi phạm",
  "order": 16,
  "description": "Lượng nhiều hay ít, thừa hay vô ích; điều có hại; và việc coi thường luật lệ. Nhiều từ lấy từ bộ từ bạn sưu tầm.",
  "groups": [
    {
      "id": "abundant",
      "title": "Dồi dào, nhiều",
      "direction": "neutral",
      "scale": false,
      "note": "Prodigious: to lớn đến kinh ngạc. Inordinate: quá mức hợp lý (chê)."
    },
    {
      "id": "scarce",
      "title": "Khan hiếm, ít ỏi",
      "direction": "negative",
      "scale": false,
      "note": "Paucity/dearth: sự khan hiếm (danh từ). Scant/meager: ít ỏi, không đủ."
    },
    {
      "id": "useless",
      "title": "Thừa, vô ích",
      "direction": "negative",
      "scale": false,
      "note": "Superfluous/redundant: thừa. Nugatory/futile: vô giá trị, vô ích. Gratuitous: không cần thiết, vô cớ."
    },
    {
      "id": "harmful",
      "title": "Có hại",
      "direction": "negative",
      "scale": false,
      "note": "Pernicious/insidious: tác hại âm thầm, dần dần. Deleterious/noxious: có hại nói chung. Malign/malevolent: ác ý."
    },
    {
      "id": "defy",
      "title": "Coi thường, vi phạm",
      "direction": "negative",
      "scale": false,
      "note": "Bẫy: flout (coi thường luật) khác flaunt (khoe khoang)."
    }
  ],
